# AWS Region Configuration
aws_region = "us-east-1"

# Project Configuration
project_name = "firehose-s3tables"
environment  = "dev"

# S3 Tables Configuration
# Replace these with your actual S3 Tables configuration
s3_table_namespace  = "my_namespace"
s3_table_name       = "my_table"
s3_table_bucket_arn = "arn:aws:s3:::my-s3-tables-bucket"

# Firehose Buffer Configuration
firehose_buffer_size     = 5    # MB (1-128)
firehose_buffer_interval = 300  # seconds (60-900)

# Compression Format
# Options: UNCOMPRESSED, GZIP, ZIP, SNAPPY, HADOOP_SNAPPY
firehose_compression_format = "GZIP"

# CloudWatch Logging
enable_cloudwatch_logging = true

# Lake Formation Integration
lake_formation_enabled = true

# Common Tags
common_tags = {
  Environment = "dev"
  Project     = "firehose-s3tables"
  ManagedBy   = "Terraform"
  Owner       = "data-engineering"
}
